# ==============================================================================
# Delgone Digital Sales Ledger - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services:
# cp .env.example .env
# ==============================================================================

# Application General Settings
ENVIRONMENT=development
PROJECT_NAME="Delgone Digital Sales Ledger"
API_V1_STR=/api
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB

# PostgreSQL Database Credentials
POSTGRES_USER=delgone_user
POSTGRES_PASSWORD=delgone_secure_password_replace_in_prod
POSTGRES_DB=delgone_ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
# For local development with PostgreSQL:
DATABASE_URL=postgresql+psycopg://delgone_user:delgone_secure_password_replace_in_prod@localhost:5432/delgone_ledger
# For Docker Compose (service name is 'db'):
# DATABASE_URL=postgresql+psycopg://delgone_user:delgone_secure_password_replace_in_prod@db:5432/delgone_ledger

# Security & Authentication (Prepared for Phase 2)
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="Delgone Digital Sales Ledger"
