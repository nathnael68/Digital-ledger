# ==============================================================================
# Delgone Digital Sales Ledger - Backend Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Delgone Digital Sales Ledger"
API_V1_STR=/api
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_USER=delgone_user
POSTGRES_PASSWORD=delgone_secure_password_replace_in_prod
POSTGRES_DB=delgone_ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
# PostgreSQL for local / Docker:
DATABASE_URL=postgresql+psycopg://delgone_user:delgone_secure_password_replace_in_prod@localhost:5432/delgone_ledger
# SQLite alternative for lightweight local testing without running PostgreSQL:
# DATABASE_URL=sqlite:///./delgone_ledger.db

# Security & Authentication (Phase 2 readiness)
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
