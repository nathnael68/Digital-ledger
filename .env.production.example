# ==============================================================================
# Delgone Digital Sales Ledger - Production Environment Template
# Delgone Trading PLC - Addis Ababa, Ethiopia
# ==============================================================================
# Copy this file to .env.production on your Ubuntu VPS:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# IMPORTANT:
#   1. Replace all placeholder values before launching in production.
#   2. Never commit .env.production to version control (GitHub).
#   3. Use cryptographically random strings for passwords and secret keys.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="Delgone Digital Sales Ledger"
API_V1_STR=/api
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB
LOG_LEVEL=INFO

# Production Domain & Web Endpoints
# Example: ledger.delgone.com
DOMAIN_NAME=ledger.delgone.com
CORS_ORIGINS=["https://ledger.delgone.com"]

# PostgreSQL Database Credentials
# NOTE: In docker-compose.prod.yml, PostgreSQL is NOT exposed to the public internet.
# Generate a strong password: openssl rand -hex 24
POSTGRES_USER=delgone_prod_user
POSTGRES_PASSWORD=generate_a_cryptographically_secure_password_here
POSTGRES_DB=delgone_sales_ledger

# Security & JWT Authentication
# Generate a 64-character secret key: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Automated Backups
BACKUP_DIR=/var/backups/delgone_ledger
DB_CONTAINER_NAME=delgone_prod_db
